<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_home_gradient"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <ImageView
        android:id="@+id/homeLogo"
            android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/logo_main"
        android:layout_marginBottom="16dp"
        android:contentDescription="TukoKadi logo" />

    <TextView
        android:textColor="#F3EFE6"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:textSize="44sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TUKO KADI"
        android:letterSpacing="0.05"
        android:layout_marginBottom="28dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp">
        <ImageView
            android:id="@+id/botPlayButton"
            android:background="@drawable/g_bg_card_white"
            android:clipToOutline="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/bot_play_photo" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp">
        <ImageView
            android:id="@+id/rafikiPlayButton"
            android:background="@drawable/g_bg_card"
            android:clipToOutline="true"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/rafiki_play_photo" />
    </LinearLayout>
    

    <Button
        android:id="@+id/gameHistoryButton"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="Game History"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/btn_game_history"
        android:elevation="6dp"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/faqsButton"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="\? FAQs"
        android:textColor="#34D399"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@android:color/transparent"
        android:elevation="6dp"/>

</LinearLayout>
