<?xml version="1.0" encoding="utf-8"?>
<!--
  Auth screen dimensions - DEFAULT bucket.
  This is the fallback used when no sw* bucket matches (widths below 320dp),
  and it deliberately mirrors the compact 320dp layout so very small / old
  phones get a tight, non-cramped fit.
  Buckets: values-sw320dp (<= phones), values-sw360dp (most phones),
  values-sw600dp (tablets).
-->
