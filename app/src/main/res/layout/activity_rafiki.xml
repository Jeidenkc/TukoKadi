<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/screen_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="♠♥ RAFIKI PLAY ♦♣"
        android:textColor="#FFD54A"
        android:textSize="26sp"
        android:textStyle="bold"
        android:shadowColor="#FFAA00"
        android:shadowRadius="12"
        android:layout_marginBottom="20dp"/>

    <!-- MENU: create or join -->
    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:hint="Your name"
            android:maxLength="20"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAFFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Room size"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <RadioGroup
            android:id="@+id/sizeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/size2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="2 players"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFD54A"/>

            <RadioButton
                android:id="@+id/size3"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="3 players"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFD54A"/>

            <RadioButton
                android:id="@+id/size4"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="4 players"
                android:textColor="#FFFFFF"
                android:buttonTint="#FFD54A"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_gold"
            android:text="CREATE ROOM"
            android:textColor="#0B3D1E"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="— or join a friend —"
            android:textColor="#CCFFFFFF"/>

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:hint="ROOM CODE"
            android:maxLength="4"
            android:inputType="textCapCharacters"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnJoin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_gold"
            android:text="JOIN ROOM"
            android:textColor="#0B3D1E"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- LOBBY: waiting for friends -->
    <LinearLayout
        android:id="@+id/lobbyPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROOM CODE"
            android:textColor="#CCFFFFFF"/>

        <TextView
            android:id="@+id/roomCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="----"
            android:textColor="#FFD54A"
            android:textSize="48sp"
            android:textStyle="bold"
            android:shadowColor="#FFAA00"
            android:shadowRadius="14"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/playersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/chip_bg"
            android:minWidth="220dp"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

        <Button
        android:id="@+id/btnAddBot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Bot"
        android:textColor="#D4AF37"
        android:textStyle="bold"
        android:background="@android:color/transparent"
        android:layout_marginBottom="12dp" />

    <Button
            android:id="@+id/btnLeave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_gold"
            android:text="LEAVE ROOM"
            android:textColor="#0B3D1E"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
