<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_home_gradient"
    android:padding="28dp">

    <ImageView
        android:id="@+id/homeLogo"
            android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/logo_main"
        android:layout_marginBottom="16dp"
        android:contentDescription="TukoKadi logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TUKO KADI"
        android:textColor="#D4AF37"
        android:textSize="38sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="40dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:gravity="center"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/botPlayButton"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/bot_play_photo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOT PLAY"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/rafikiPlayButton"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/rafiki_play_photo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAFIKI PLAY"
                android:textColor="#D4AF37"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/gameHistoryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="Game History"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/btn_game_history"
        android:elevation="6dp"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/faqsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="\? FAQs"
        android:textColor="#D4AF37"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@android:color/transparent"
        android:elevation="6dp"/>

</LinearLayout>
