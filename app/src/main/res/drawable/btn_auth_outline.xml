<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary / "Back to Login" style outlined button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/auth_button_radius" />
            <stroke android:width="1dp" android:color="@color/auth_input_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/auth_button_radius" />
            <stroke android:width="1.5dp" android:color="@color/auth_accent" />
        </shape>
    </item>
</selector>
