<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#33F0555A"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/g_danger"/></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/g_danger"/></shape>
    </item>
</selector>
