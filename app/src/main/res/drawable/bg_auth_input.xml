<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark input box; border turns accent-green while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_input_bg" />
            <corners android:radius="@dimen/auth_field_radius" />
            <stroke android:width="1.5dp" android:color="@color/auth_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_input_bg" />
            <corners android:radius="@dimen/auth_field_radius" />
            <stroke android:width="1dp" android:color="@color/auth_input_stroke" />
        </shape>
    </item>
</selector>
