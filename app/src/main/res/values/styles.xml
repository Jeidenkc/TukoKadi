<?xml version="1.0" encoding="utf-8"?>
<!--
  Auth theme: styles + a scoped Activity theme used only by the auth-flow
  screens (login, register, reset, onboarding, legal). Applied per-activity in
  the manifest so the rest of the app's look is untouched.
-->
<resources>

    <!-- Scoped theme: no system title bar, navy window + status bar to match
         the gradient so there is no white flash / white status strip. -->
    <style name="TukoKadi.Auth" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_auth_gradient</item>
        <item name="android:statusBarColor">@color/auth_navy_bottom</item>
        <item name="android:navigationBarColor">@color/auth_navy_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/auth_accent</item>
    </style>

    <!-- ===== Text ===== -->
    <style name="AuthTitle" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/auth_title</item>
        <item name="android:textSize">@dimen/auth_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AuthSubtitle" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/auth_subtitle</item>
        <item name="android:textSize">@dimen/auth_subtitle_size</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AuthHeading" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/auth_title</item>
        <item name="android:textSize">@dimen/auth_heading_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AuthLabel" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/auth_subtitle</item>
        <item name="android:textSize">@dimen/auth_label_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ===== Inputs ===== -->
    <style name="AuthInput" parent="@android:style/Widget.EditText">
        <item name="android:background">@drawable/bg_auth_input</item>
        <item name="android:textColor">@color/auth_text</item>
        <item name="android:textColorHint">@color/auth_hint</item>
        <item name="android:textSize">@dimen/auth_field_text_size</item>
        <item name="android:minHeight">@dimen/auth_field_height</item>
        <item name="android:paddingStart">@dimen/auth_field_pad_h</item>
        <item name="android:paddingEnd">@dimen/auth_field_pad_h</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textColorHighlight">@color/auth_accent_dim</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="AuthPrimaryButton" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/btn_auth_primary</item>
        <item name="android:textColor">@color/auth_button_text</item>
        <item name="android:textSize">@dimen/auth_button_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/auth_button_height</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AuthOutlineButton" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/btn_auth_outline</item>
        <item name="android:textColor">@color/auth_accent</item>
        <item name="android:textSize">@dimen/auth_button_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/auth_button_height</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Borderless text button used for "Create Account ->" / "Forgot?" links. -->
    <style name="AuthTextButton" parent="@android:style/Widget.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/auth_accent</item>
        <item name="android:textSize">@dimen/auth_link_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Rounded-square back button hit target in the top bar. -->
    <style name="AuthBackButton" parent="@android:style/Widget.ImageButton">
        <item name="android:background">@drawable/bg_auth_back</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tappable teal info banner under the primary button. -->
    <style name="AuthBanner" parent="@android:style/Widget.TextView">
        <item name="android:background">@drawable/bg_auth_banner</item>
        <item name="android:textColor">@color/auth_banner_text</item>
        <item name="android:textSize">@dimen/auth_banner_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:padding">@dimen/auth_banner_pad</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
